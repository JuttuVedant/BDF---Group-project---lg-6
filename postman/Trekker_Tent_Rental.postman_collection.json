    {
      "name": "Twist tests \u2014 run in order",
      "description": "Run Twist 1, Twist 2, Twist 3A, then Twist 3B. Do not run these requests out of order.",
      "item": [
        {
          "name": "TWIST 1 \u2014 Rent Tent 8 to Asha \u2014 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rentals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rentals"
              ]
            },
            "description": "Run first. Expected: Asha successfully rents Tent 8. Save returned rental ID for the return request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trekker_id\": \"{{ashaTrekkerId}}\",\n  \"tent_id\": \"{{tent8Id}}\",\n  \"rented_date\": \"{{rentedDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data && data.id !== undefined) pm.collectionVariables.set('rentalAshaId', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "TWIST 2 \u2014 Rent Tent 8 to Ravi \u2014 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rentals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rentals"
              ]
            },
            "description": "Run second, immediately after Twist 1. Expected JSON message: \"Tent 8 is already rented\".",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trekker_id\": \"{{raviTrekkerId}}\",\n  \"tent_id\": \"{{tent8Id}}\",\n  \"rented_date\": \"{{rentedDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test('Conflict message matches', function () {",
                  "    pm.expect(pm.response.json().message).to.eql('Tent 8 is already rented');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TWIST 3A \u2014 Return Tent 8 from Asha \u2014 200",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rentals/{{rentalAshaId}}/return",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rentals",
                "{{rentalAshaId}}",
                "return"
              ]
            },
            "description": "Run after Twist 2. This releases Tent 8 before Ravi rents it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"returned_date\": \"{{returnedDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
